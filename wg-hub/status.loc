#!/bin/bash
# wg-hub/status.loc - resolve the network definition for the status report

# shellcheck disable=SC1091
source "$MOD_DIR/wgnet.loc.sh"

wgnet_load "${net:-}" || exit 1
net="$WGNET_NAME"
wgnet_peers "$net" "$MOD_TMP/peers.tab" >/dev/null || exit 1

{
  echo "WGNET_NAME=\"$net\""
  echo "WG_IFACE=\"$WG_IFACE\""
  echo "WG_PORT=\"$WG_PORT\""
  echo "WG_SUBNET=\"$WG_SUBNET\""
  echo "WG_HUB_ADDR=\"$WG_HUB_ADDR\""
  echo "LAN_POLICY=\"$LAN_POLICY\""
  [ -n "${WG_HUB_PUBKEY:-}" ] && echo "WG_HUB_PUBKEY=\"$WG_HUB_PUBKEY\""
  true   # a trailing conditional must not leak its status
} >> "$MOD_TMP/env"
