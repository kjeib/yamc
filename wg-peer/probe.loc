#!/bin/bash
# wg-peer/probe.loc - resolve the network definition for the isolation probe

# shellcheck disable=SC1091
source "$MOD_DIR/wgnet.loc.sh"

wgnet_load "${net:-}" || exit 1

{
  echo "WGNET_NAME=\"$net\""
  echo "WG_IFACE=\"$WG_IFACE\""
  echo "WG_HUB_ADDR=\"$WG_HUB_ADDR\""
  echo "WG_ENDPOINT=\"${WG_ENDPOINT:-}\""
  echo "WG_LAN_PROBE=\"${WG_LAN_PROBE:-}\""
  echo "WG_HUB_LAN_ADDR=\"${WG_HUB_LAN_ADDR:-}\""
  [ -n "${WG_HUB_PUBKEY:-}" ] && echo "WG_HUB_PUBKEY=\"$WG_HUB_PUBKEY\""
  true   # a trailing conditional must not leak its status
} >> "$MOD_TMP/env"
