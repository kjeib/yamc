#!/bin/bash
#
# YAMC - Yet Another Machine Configurator
# Remote machine configuration and management tool
#

set -e  # Exit on any errors

#
# Configuration
#
CONFIG_DIR="$HOME/.yamc"
mkdir -p "$CONFIG_DIR" 2>/dev/null || true
DEFAULT_SSH_TIMEOUT=30  # Default timeout in seconds

#
# Logging Functions
#
log() {
  local level="$1"
  local message="$2"
  
  case "$level" in
    INFO)
      echo "[INFO] $message"
      ;;
    DEBUG)
      if [ "$VERBOSE" = true ]; then
        echo "[DEBUG] $message"
      fi
      ;;
    ERROR)
      echo "[ERROR] $message" >&2
      ;;
    *)
      echo "$message"
      ;;
  esac
}

#
# Usage Information
#
show_usage() {
  cat <<EOF
Usage: yamc init -h remote_hostname -u username [-v] [-t timeout]
       yamc -h remote_hostname -u username init [-v] [-t timeout]
       yamc help [module]
       yamc -h remote_hostname [-u username] [-p profile] [-r resources] [-e var=value] [-v] [-t timeout] module [subfunction] [args...]

Commands:
  init            Initialize a host for use with YAMC (required before using other modules)
                  Must be run with a regular unprivileged user that has sudo access
  help [module]   Show site-aware help. With no module, lists every module that has
                  yamc.local/<module>/ resources. With a module, runs <module>/help.loc
                  if present, else prints a generic subcommand listing.
                  Does not require -h and does not use SSH.

Options:
  -h hostname     Target remote hostname (or set YAMC_HOST environment variable)
  -u username     Optional for modules, Required for init. SSH username (defaults to YAMC_USER or current user)
  -p profile      Optional. Resource profile name (e.g., -p master uses module.master/)
  -r path         Optional. Path to resources directory (or set YAMC_RESOURCES)
  -e var=value    Optional. Environment variables to pass to scripts (can be used multiple times)
  -v              Optional. Enable verbose output
  -t timeout      Optional. SSH connection timeout in seconds (default: 30)
  
Arguments:
  module          Required. Name of the module directory containing the scripts
  subfunction     Optional. Script to run (defaults to "setup")
  args            Optional. Additional arguments passed to the module scripts

Environment Variables:
  YAMC_HOST       Alternative to -h flag, specifies the target remote hostname
  YAMC_USER       Alternative to -u flag, specifies the SSH username
  YAMC_RESOURCES  Alternative to -r flag, path to resources directory
  YAMC_PROFILE    Alternative to -p flag, default profile name

Examples:
  export YAMC_HOST=server1
  export YAMC_USER=admin
  yamc init                              # Initialize host using environment variables
  yamc -h server1 -u regular_user init   # Command-line args override environment variables
  yamc help                              # Aggregate help for all modules with yamc.local resources
  yamc help dhcp                         # Help for the dhcp module
  yamc dhcp help                         # Same as 'yamc help dhcp'
  yamc -u root timezone America/New_York # Run module as root (after init)
  yamc pref                              # Set user preferences, uses YAMC_HOST and YAMC_USER
  yamc -v test                           # Run test with verbose output, uses environment vars
  yamc -p master named setup             # Use named.master/ resources for DNS master server
  yamc -r ~/private/configs named edit   # Use explicit resources directory
EOF
  exit 1
}

#
# Host Initialization
#

#
# Local Cache Helpers
#
detect_sftp_server() {
  local sftp_server=""

  # First check common locations
  for path in "/usr/libexec/sftp-server" "/usr/lib/openssh/sftp-server" "$(which sftp-server 2>/dev/null)"; do
    if [ -n "$path" ] && [ -x "$path" ]; then
      sftp_server="$path"
      break
    fi
  done

  # If not found, try to search for it
  if [ -z "$sftp_server" ]; then
    for search_path in "/usr/lib" "/usr/libexec" "/usr/local/lib" "/opt"; do
      if [ -d "$search_path" ]; then
        found=$(find "$search_path" -name "sftp-server" -type f -executable 2>/dev/null | head -1)
        if [ -n "$found" ]; then
          sftp_server="$found"
          break
        fi
      fi
    done
  fi

  echo "$sftp_server"
}

ensure_local_cache() {
  local local_cache_file="$CONFIG_DIR/yamc.env"
  local saved_yamc_user="${YAMC_USER:-}"

  # Load local cache if present
  if [ -f "$local_cache_file" ]; then
    # shellcheck disable=SC1090
    source "$local_cache_file"
  fi

  # Restore YAMC_USER to avoid local cache accidentally affecting SSH user precedence
  if [ -n "$saved_yamc_user" ]; then
    YAMC_USER="$saved_yamc_user"
  else
    unset YAMC_USER 2>/dev/null || true
  fi

  # If cached value exists and is valid, we're done
  if [ -n "${YAMC_SFTP_SERVER:-}" ] && [ -x "${YAMC_SFTP_SERVER:-}" ]; then
    return 0
  fi

  log INFO "Detecting sftp-server path (local cache: $local_cache_file)"
  local sftp_server
  sftp_server="$(detect_sftp_server)"

  if [ -z "$sftp_server" ]; then
    log ERROR "Could not find sftp-server binary on the local system."
    log ERROR "Please install OpenSSH (client/server) or locate sftp-server manually."
    return 1
  fi

  log INFO "Found sftp-server at: $sftp_server"

  # Write (or refresh) local cache
  cat > "$local_cache_file" <<EOF
# YAMC local cache (generated)
# Generated on $(date)
YAMC_SFTP_SERVER=$sftp_server
EOF

  # Reload cache so caller sees YAMC_SFTP_SERVER
  # shellcheck disable=SC1090
  source "$local_cache_file"

  # Re-apply saved YAMC_USER again (see above)
  if [ -n "$saved_yamc_user" ]; then
    YAMC_USER="$saved_yamc_user"
  else
    unset YAMC_USER 2>/dev/null || true
  fi

  return 0
}

init_host() {
  local host="$1"
  local ssh_user="$2"
  local timeout="$3"
  local verbose="$4"
  
  log INFO "Initializing host $host for YAMC usage"
  
  # Create config file for this host
  local host_config_file="$CONFIG_DIR/${host}.env"
  rm -f "$host_config_file" 2>/dev/null || true

  # Ensure local cache exists (sftp-server path, etc.)
  if ! ensure_local_cache; then
    return 1
  fi
  
  # Ensure an SSH key exists locally
  if [ ! -f "$HOME/.ssh/id_rsa" ] && [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    log INFO "No SSH key found. Generating SSH key..."
    ssh-keygen -t rsa -b 4096 -f "$HOME/.ssh/id_rsa" -N ""
    if [ $? -ne 0 ]; then
      log ERROR "Failed to generate SSH key"
      return 1
    fi
  fi
  
  # Check if SSH key is installed on the remote machine
  log INFO "Checking SSH key authentication..."
  if ! ssh -o BatchMode=yes -o ConnectTimeout="$timeout" "$ssh_user@$host" "echo 'SSH key authentication working'" >/dev/null 2>&1; then
    log INFO "SSH key not found on remote host. Installing..."
    
    # Install the SSH key on the remote machine
    ssh-copy-id "$ssh_user@$host"
    
    # Re-check if key authentication works
    if ! ssh -o BatchMode=yes -o ConnectTimeout="$timeout" "$ssh_user@$host" "echo 'SSH key authentication working'" >/dev/null 2>&1; then
      log ERROR "SSH key authentication failed even after installation."
      return 1
    fi
    
    log INFO "SSH key installed successfully"
  else
    log INFO "SSH key authentication already working"
  fi
  
  # Check if SSHFS is installed on the remote machine
  log INFO "Checking if SSHFS is installed on $host..."
  SSHFS_CHECK=$(ssh -o ConnectTimeout="$timeout" "$ssh_user@$host" "command -v sshfs >/dev/null 2>&1 && echo 'exists' || echo 'missing'")
  
  if [ "$SSHFS_CHECK" = "missing" ]; then
    log INFO "SSHFS not found on $host. Installing..."
    
    # Use -t flag for interactive sudo password prompt
    log INFO "You may be prompted for the sudo password on the remote host"
    ssh -t -o ConnectTimeout="$timeout" "$ssh_user@$host" "sudo apt-get update -qq && sudo apt-get install -y sshfs"
    
    # Verify installation was successful
    SSHFS_VERIFY=$(ssh -o ConnectTimeout="$timeout" "$ssh_user@$host" "command -v sshfs >/dev/null 2>&1 && echo 'exists' || echo 'missing'")
    
    if [ "$SSHFS_VERIFY" = "missing" ]; then
      log ERROR "Failed to install SSHFS on remote host"
      log ERROR "Please install SSHFS manually and run yamc init again"
      return 1
    fi
    
    log INFO "SSHFS installed successfully"
  else
    log INFO "SSHFS is already installed on $host"
  fi
  
  # Store minimal host preferences in host config file
  log INFO "Saving host preferences to $host_config_file"
  cat > "$host_config_file" <<EOF
# YAMC environment configuration for $host
# Generated on $(date)
# Do not edit manually - rerun 'yamc init' to regenerate

# Host default SSH user (regular / bootstrap user; do not store root here)
YAMC_USER=$ssh_user
EOF
  
  log INFO "Host $host successfully initialized"
  log INFO "You can now run YAMC modules without going through initialization"
  return 0
}

#
# Help / Introspection (hostless, no SSH)
#

# Resolve the INSTALL_DIR (yamc source/install directory) into the global INSTALL_DIR.
resolve_install_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -L "$script_dir/yamc" ]; then
    INSTALL_DIR="$(readlink "$script_dir/yamc" | xargs dirname)"
  else
    INSTALL_DIR="$script_dir"
  fi
}

# Resolve RESOURCES_ROOT (yamc.local) using -r, YAMC_RESOURCES, or sibling dir.
# Sets the global RESOURCES_ROOT (may remain empty if none found).
resolve_resources_root() {
  RESOURCES_ROOT=""
  if [ -n "$RESOURCES_PATH" ]; then
    if [ -d "$RESOURCES_PATH" ]; then
      RESOURCES_ROOT="$RESOURCES_PATH"
    fi
  else
    local yamc_local_path
    yamc_local_path="$(dirname "$INSTALL_DIR")/yamc.local"
    if [ -d "$yamc_local_path" ]; then
      RESOURCES_ROOT="$yamc_local_path"
    fi
  fi
}

# Locate a module directory. Echoes path on stdout; returns non-zero if not found.
# A directory is treated as a module if it has setup, setup.loc, help, or help.loc.
find_module_dir() {
  local module="$1"
  local paths=(
    "$module"
    "$HOME/.yamc/modules/$module"
    "/etc/yamc/modules/$module"
    "$INSTALL_DIR/modules/$module"
    "$INSTALL_DIR/$module"
  )
  local p
  for p in "${paths[@]}"; do
    if [ -d "$p" ] && \
       ( [ -f "$p/setup" ] || [ -f "$p/setup.loc" ] || \
         [ -f "$p/help" ]  || [ -f "$p/help.loc" ] ); then
      echo "$p"
      return 0
    fi
  done
  return 1
}

# List subfunctions for a module by scanning for scripts and *.loc files.
# Prints one subfunction name per line, sorted.
list_subfunctions() {
  local mod_dir="$1"
  local f name base
  local seen=""
  local entries=""
  for f in "$mod_dir"/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    case "$name" in
      *.md|*.env|README*|tmp-*|*.bak) continue ;;
      *.conf|*.json|*.yaml|*.yml|*.list|*.ppd|*.txt) continue ;;
    esac
    if [[ "$name" == *.loc ]]; then
      base="${name%.loc}"
    elif [ -x "$f" ]; then
      base="$name"
    else
      continue
    fi
    case " $seen " in
      *" $base "*) ;;
      *) seen="$seen $base"; entries="$entries$base"$'\n' ;;
    esac
  done
  if [ -n "$entries" ]; then
    printf '%s' "$entries" | sort
  fi
}

# Resolve module-specific RES_DIR / RES_BASE for the help context (no profile mounting).
# Sets globals RES_DIR_HELP and RES_BASE_HELP.
resolve_module_resources() {
  local module="$1"
  RES_DIR_HELP=""
  RES_BASE_HELP=""
  if [ -z "$RESOURCES_ROOT" ]; then
    return 0
  fi
  if [ -d "$RESOURCES_ROOT/$module" ]; then
    RES_BASE_HELP="$RESOURCES_ROOT/$module"
  fi
  if [ -n "$PROFILE" ] && [ -d "$RESOURCES_ROOT/${module}.${PROFILE}" ]; then
    RES_DIR_HELP="$RESOURCES_ROOT/${module}.${PROFILE}"
  else
    RES_DIR_HELP="$RES_BASE_HELP"
  fi
  if [ -z "$RES_BASE_HELP" ] && [ -n "$RES_DIR_HELP" ]; then
    RES_BASE_HELP="$RES_DIR_HELP"
  fi
}

# Print generic fallback help for a module that has no help.loc.
print_module_help_fallback() {
  local module="$1"
  local mod_dir="$2"
  local res_dir="$3"

  echo "Module: $module"
  echo "  Path:      $mod_dir"
  if [ -n "$res_dir" ]; then
    echo "  Resources: $res_dir"
  else
    echo "  Resources: (none under yamc.local/)"
  fi
  if [ -f "$mod_dir/README.md" ]; then
    echo "  Docs:      $mod_dir/README.md"
  fi

  local subs
  subs="$(list_subfunctions "$mod_dir")"
  if [ -n "$subs" ]; then
    echo "  Subcommands:"
    local s
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      echo "    $s"
    done <<< "$subs"
  fi

  echo ""
  echo "  Usage: yamc -h <host> [-u <user>] $module [subcommand]"
  echo "  (No help.loc defined. Create $mod_dir/help.loc for module-specific help.)"
}

# Run help for a single module.
run_module_help() {
  local module="$1"

  local mod_dir
  if ! mod_dir="$(find_module_dir "$module")"; then
    log ERROR "Module '$module' not found"
    log ERROR "Searched in:"
    log ERROR "  - $module (absolute path)"
    log ERROR "  - $HOME/.yamc/modules/$module"
    log ERROR "  - /etc/yamc/modules/$module"
    log ERROR "  - $INSTALL_DIR/modules/$module"
    log ERROR "  - $INSTALL_DIR/$module"
    return 1
  fi

  resolve_module_resources "$module"

  if [ -f "$mod_dir/help.loc" ]; then
    # help.loc is sourced in a subshell so it cannot pollute our env.
    # Guard set -e so a help.loc returning non-zero does not kill yamc.
    set +e
    (
      export MOD_DIR="$mod_dir"
      export RES_DIR="$RES_DIR_HELP"
      export RES_BASE="$RES_BASE_HELP"
      export YAMC_MODULE="$module"
      export INSTALL_DIR
      export RESOURCES_ROOT
      # shellcheck disable=SC1090
      source "$mod_dir/help.loc"
    )
    local rc=$?
    set -e
    return $rc
  fi

  print_module_help_fallback "$module" "$mod_dir" "$RES_DIR_HELP"
  return 0
}

# Run aggregate help: every module that has yamc.local/<module>/ resources
# and a matching installed module.
run_aggregate_help() {
  if [ -z "$RESOURCES_ROOT" ]; then
    echo "No yamc.local resources directory found."
    echo "Use 'yamc help <module>' to see help for a specific module,"
    echo "or pass -r <path> to point at a resources directory."
    return 0
  fi

  echo "YAMC resources root: $RESOURCES_ROOT"
  echo ""

  # Collect candidate module names from yamc.local/* (strip .profile suffix).
  local d name base modules=""
  for d in "$RESOURCES_ROOT"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    base="${name%%.*}"
    if find_module_dir "$base" >/dev/null 2>&1; then
      case " $modules " in
        *" $base "*) ;;
        *) modules="$modules $base" ;;
      esac
    fi
  done

  modules="$(echo "$modules" | tr ' ' '\n' | sort -u | grep -v '^$' || true)"

  if [ -z "$modules" ]; then
    echo "No modules found with both yamc.local/<module>/ and an installed module."
    return 0
  fi

  local m first=true
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    if [ "$first" = true ]; then
      first=false
    else
      echo ""
    fi
    echo "=== $m ==="
    run_module_help "$m" || true
  done <<< "$modules"
}

# Parse the 'help' subcommand args (options + optional module name).
parse_help_command() {
  local OPTIND=1
  while getopts "p:r:v" opt "$@"; do
    case $opt in
      p) PROFILE="$OPTARG" ;;
      r) RESOURCES_PATH="$OPTARG" ;;
      v) VERBOSE=true ;;
      *) : ;;
    esac
  done
  shift $((OPTIND-1))

  resolve_install_dir
  resolve_resources_root

  if [ $# -eq 0 ]; then
    run_aggregate_help
  else
    run_module_help "$1"
  fi
  exit $?
}

#
# File Sharing Functions
#
reverse_sshfs_mount() {
  local localpath="$1"
  local remotehost="$2"
  local remotepath="$3"
  local fifo="/tmp/yamc-fifo-$$"
  local sftp_server="$4"

  log INFO "Setting up SSH file sharing..."
  log DEBUG "Local path: $localpath"
  log DEBUG "Remote path: $remotepath"
  log DEBUG "SFTP server: $sftp_server"
  
  # Check if sftp-server exists
  if [ ! -x "$sftp_server" ]; then
    log ERROR "SFTP server binary not found at: $sftp_server"
    log ERROR "Please ensure the local cache is present (or rerun 'yamc init')"
    return 1
  fi
  
  # Create a named pipe for communication
  log DEBUG "Creating named pipe: $fifo"
  mkfifo -m600 "$fifo"
  
  # Create the remote directory
  if ! ssh "$remotehost" "mkdir -p \"$remotepath\""; then
    local ssh_result=$?
    log ERROR "Failed to create remote mount dir (exit $ssh_result)"
    rm -f "$fifo"
    return 1
  fi
  
  # Start the file sharing in the background
  log DEBUG "Starting SFTP server and SSHFS connection"
  < "$fifo" "$sftp_server" | ssh "$remotehost" "sshfs -o slave \":$localpath\" \"$remotepath\"" > "$fifo" &
  
  # Give it a moment to connect
  sleep 2
  
  # Verify the mount was successful
  local mount_check
  if ! mount_check=$(ssh "$remotehost" "[ -d \"$remotepath/\" ] && ls -la \"$remotepath/\" >/dev/null 2>&1 && echo 'mounted' || echo 'failed'"); then
    local ssh_result=$?
    log ERROR "Failed to verify remote mount (exit $ssh_result)"
    rm -f "$fifo"
    return 1
  fi
  
  if [ "$mount_check" != "mounted" ]; then
    log ERROR "Failed to mount remote directory. SSHFS mount unsuccessful."
    log ERROR "Hint: rerun yamc init for this host and verify key-based SSH works."
    rm -f "$fifo"
    return 1
  fi
  
  # Set the global variable so we can clean it up later
  REMOTE_MOUNT="$remotepath"
  FIFO_PATH="$fifo"
  
  log INFO "File sharing established: $localpath -> $remotehost:$remotepath"
  return 0
}

#
# Cleanup Functions
#
cleanup() {
  local exit_code=$?
  log INFO "Cleaning up temporary resources..."
  
  # If resources SSHFS was mounted, unmount it first
  if [ ! -z "$REMOTE_RES_MOUNT" ]; then
    log DEBUG "Unmounting remote resources directory: $REMOTE_RES_MOUNT"
    ssh "$SSH_USER@$HOST" "fusermount -u \"$REMOTE_RES_MOUNT\"" 2>/dev/null || true
  fi
  
  # If module SSHFS was mounted, unmount it
  if [ ! -z "$REMOTE_MOUNT" ]; then
    log DEBUG "Unmounting remote SSHFS directory: $REMOTE_MOUNT"
    ssh "$SSH_USER@$HOST" "fusermount -u \"$REMOTE_MOUNT\"" 2>/dev/null || true
  fi
  
  # Clean up remote temporary directory
  if [ ! -z "$REMOTE_TMP" ]; then
    log DEBUG "Cleaning up remote temporary directory: $REMOTE_TMP"
    ssh "$SSH_USER@$HOST" "rm -rf \"$REMOTE_TMP\"" 2>/dev/null || true
  fi
  
  # Remove local temporary files and directories
  log DEBUG "Cleaning up local temporary files"
  
  # CRITICAL SAFETY CHECK for MOD_TMP deletion
  # Only remove MOD_TMP if it:
  # 1. Is defined (not empty)
  # 2. Contains the string "tmp-" (our naming convention)
  # 3. Is a subdirectory of MOD_DIR (not MOD_DIR itself)
  # 4. Actually exists as a directory
  if [ ! -z "$MOD_TMP" ] && [[ "$MOD_TMP" == *"tmp-"* ]] && 
     [[ "$MOD_TMP" != "$MOD_DIR" ]] && 
     [[ "$MOD_TMP" == "$MOD_DIR/"* ]] && 
     [ -d "$MOD_TMP" ]; then
    log DEBUG "Removing temporary directory: $MOD_TMP"
    rm -rf "$MOD_TMP" 2>/dev/null || true
  else
    log DEBUG "Skipping MOD_TMP removal due to safety checks: $MOD_TMP"
  fi
  
  # Remove named pipes if they exist
  if [ ! -z "$FIFO_PATH" ] && [ -p "$FIFO_PATH" ]; then
    log DEBUG "Removing named pipe: $FIFO_PATH"
    rm -f "$FIFO_PATH" 2>/dev/null || true
  fi
  if [ ! -z "$RES_FIFO_PATH" ] && [ -p "$RES_FIFO_PATH" ]; then
    log DEBUG "Removing resources named pipe: $RES_FIFO_PATH"
    rm -f "$RES_FIFO_PATH" 2>/dev/null || true
  fi
  
  log INFO "Cleanup completed"
  exit $exit_code
}

#
# Command Line Parsing
#
parse_init_command() {
  # Parse options for init command
  local OPTIND=1  # Reset OPTIND to ensure proper parsing
  
  while getopts "h:u:vt:" opt "$@"; do
    case $opt in
      h) HOST="$OPTARG" ;;
      u) SSH_USER="$OPTARG" ; CLI_SSH_USER_SPECIFIED=true ;;
      v) VERBOSE=true ;;
      t) SSH_TIMEOUT="$OPTARG" ;;
      *) show_usage ;;
    esac
  done
  
  # Check required parameters for init
  if [ -z "$HOST" ]; then
    log ERROR "Remote hostname (-h) is required for initialization or set YAMC_HOST environment variable"
    show_usage
  fi
  
  if [ -z "$SSH_USER" ]; then
    log ERROR "Username (-u) is required for initialization or set YAMC_USER environment variable"
    log ERROR "Must specify a regular unprivileged user with sudo access"
    show_usage
  fi
  
  # Run initialization
  init_host "$HOST" "$SSH_USER" "$SSH_TIMEOUT" "$VERBOSE"
  exit $?
}

parse_module_command() {
  # Parse options for module command
  local OPTIND=1  # Reset OPTIND to ensure proper parsing
  
  while getopts "h:u:p:r:e:vt:" opt "$@"; do
    case $opt in
      h) HOST="$OPTARG" ;;
      u) SSH_USER="$OPTARG" ; CLI_SSH_USER_SPECIFIED=true ;;
      p) PROFILE="$OPTARG" ;;
      r) RESOURCES_PATH="$OPTARG" ;;
      e) ENV_VARS+=("$OPTARG") ;;
      v) VERBOSE=true ;;
      t) SSH_TIMEOUT="$OPTARG" ;;
      *) show_usage ;;
    esac
  done

  # Shift past the options using the original args
  shift $((OPTIND-1))

  # Get the module and subfunction and additional args
  if [ $# -gt 0 ]; then
    MODULE="$1"
    shift
    
    if [ $# -gt 0 ]; then
      SUBFUNC="$1"
      shift
    fi
    
    # Any remaining args will be passed to the module scripts
    MODULE_ARGS=("$@")
  else
    show_usage
  fi

  # Check required parameters
  if [ -z "$HOST" ]; then
    log ERROR "Remote hostname (-h) is required or set YAMC_HOST environment variable"
    show_usage
  fi

  if [ -z "$MODULE" ]; then
    log ERROR "Module name is required"
    show_usage
  fi
}

run_module() {
  # These variables should already be set globally
  # HOST, SSH_USER, MODULE, SUBFUNC are used from global context
  
  # Setup base paths
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  
  # Resolve installation directory
  if [ -L "$SCRIPT_DIR/yamc" ]; then
    # We're running from a symlink in bin directory
    INSTALL_DIR="$(readlink "$SCRIPT_DIR/yamc" | xargs dirname)"
  else
    # We're running directly from the script location
    INSTALL_DIR="$SCRIPT_DIR"
  fi
  
  # Define module search paths
  MODULE_PATHS=(
    # First, check if MODULE is an absolute path to a directory
    "$MODULE"
    # Check in user's personal modules
    "$HOME/.yamc/modules/$MODULE"
    # Check in system-wide custom modules
    "/etc/yamc/modules/$MODULE"
    # Check in the installation directory (installed layout)
    "$INSTALL_DIR/modules/$MODULE"
    # Check in the installation directory (source layout - modules at top level)
    "$INSTALL_DIR/$MODULE"
  )
  
  # Find the module directory
  # A valid module has either a 'setup' script or a 'setup.loc' script
  MOD_DIR=""
  for path in "${MODULE_PATHS[@]}"; do
    if [ -d "$path" ] && ( [ -f "$path/setup" ] || [ -f "$path/setup.loc" ] ); then
      MOD_DIR="$path"
      break
    fi
  done
  
  # Set up trap to ensure cleanup on exit
  trap cleanup EXIT INT TERM
  
  # Check if module exists
  if [ -z "$MOD_DIR" ] || [ ! -d "$MOD_DIR" ]; then
    log ERROR "Module '$MODULE' not found in any of the search paths"
    log ERROR "Searched in:"
    log ERROR "  - $MODULE (absolute path)"
    log ERROR "  - $HOME/.yamc/modules/$MODULE (user modules)"
    log ERROR "  - /etc/yamc/modules/$MODULE (system modules)"
    log ERROR "  - $INSTALL_DIR/modules/$MODULE (installed modules)"
    log ERROR "  - $INSTALL_DIR/$MODULE (source directory)"
    exit 1
  fi
  
  # Create the temp directory as a subdirectory of the module directory
  MOD_TMP="$MOD_DIR/tmp-$$"
  mkdir -p "$MOD_TMP"

  #
  # Resolve Resources Directory
  #
  RESOURCES_ROOT=""
  
  # Priority: 1) -r flag, 2) YAMC_RESOURCES env, 3) ../yamc.local sibling
  if [ ! -z "$RESOURCES_PATH" ]; then
    # Explicit path provided
    if [ -d "$RESOURCES_PATH" ]; then
      RESOURCES_ROOT="$RESOURCES_PATH"
      log DEBUG "Using explicit resources path: $RESOURCES_ROOT"
    else
      log ERROR "Specified resources path does not exist: $RESOURCES_PATH"
      exit 1
    fi
  else
    # Check for yamc.local sibling directory
    YAMC_LOCAL_PATH="$(dirname "$INSTALL_DIR")/yamc.local"
    if [ -d "$YAMC_LOCAL_PATH" ]; then
      RESOURCES_ROOT="$YAMC_LOCAL_PATH"
      log DEBUG "Found yamc.local sibling: $RESOURCES_ROOT"
    fi
  fi
  
  # Resolve module-specific resources with profile support
  RES_DIR=""
  RES_BASE=""
  res_profile="$PROFILE"
  
  if [ ! -z "$RESOURCES_ROOT" ]; then
    # Set base resources path (without profile)
    if [ -d "$RESOURCES_ROOT/$MODULE" ]; then
      RES_BASE="$RESOURCES_ROOT/$MODULE"
      log DEBUG "Found base resources: $RES_BASE"
    fi
    
    # Check for profile-specific resources
    if [ ! -z "$PROFILE" ]; then
      if [ -d "$RESOURCES_ROOT/${MODULE}.${PROFILE}" ]; then
        RES_DIR="$RESOURCES_ROOT/${MODULE}.${PROFILE}"
        log DEBUG "Found profile resources: $RES_DIR"
      else
        log DEBUG "No profile-specific resources at: $RESOURCES_ROOT/${MODULE}.${PROFILE}"
        # Fall back to base if profile doesn't exist
        RES_DIR="$RES_BASE"
      fi
    else
      # No profile specified, use base
      RES_DIR="$RES_BASE"
    fi
    
    # If RES_BASE is empty but RES_DIR is set, make them the same
    if [ -z "$RES_BASE" ] && [ ! -z "$RES_DIR" ]; then
      RES_BASE="$RES_DIR"
    fi
    
    if [ ! -z "$RES_DIR" ]; then
      log INFO "Using resources: $RES_DIR"
    fi
  fi

  # Check if subfunction script exists (either remote or local-only)
  # If not, treat SUBFUNC as an argument and fall back to "setup"
  LOCAL_ONLY=false
  if [ ! -f "$MOD_DIR/$SUBFUNC" ] && [ ! -f "$MOD_DIR/${SUBFUNC}.loc" ]; then
    # SUBFUNC script doesn't exist - check if "setup" exists
    if [ -f "$MOD_DIR/setup" ] || [ -f "$MOD_DIR/setup.loc" ]; then
      # "setup" exists, so SUBFUNC was actually an argument, not a subcommand
      log DEBUG "No script '$SUBFUNC' found, treating as argument to 'setup'"
      # Prepend SUBFUNC to MODULE_ARGS
      MODULE_ARGS=("$SUBFUNC" "${MODULE_ARGS[@]}")
      SUBFUNC="setup"
    else
      log ERROR "Neither '$SUBFUNC' nor '${SUBFUNC}.loc' found in module '$MODULE'"
      exit 1
    fi
  fi
  
  # Now check if we're using a local-only script
  if [ ! -f "$MOD_DIR/$SUBFUNC" ]; then
    if [ -f "$MOD_DIR/${SUBFUNC}.loc" ]; then
      LOCAL_ONLY=true
      log DEBUG "Detected local-only module: $MODULE/$SUBFUNC"
    fi
  fi

  #
  # Load Optional Host + Module Environment
  #
  HOST_CONFIG_FILE="$CONFIG_DIR/${HOST}.env"
  if [ -f "$HOST_CONFIG_FILE" ]; then
    log DEBUG "Loading host preferences from $HOST_CONFIG_FILE"
    # shellcheck disable=SC1090
    source "$HOST_CONFIG_FILE"
  else
    log DEBUG "No host preferences found at $HOST_CONFIG_FILE (this is OK)"
  fi

  MODULE_ENV_FILE="$MOD_DIR/yamc.env"
  if [ -f "$MODULE_ENV_FILE" ]; then
    log DEBUG "Loading module defaults from $MODULE_ENV_FILE"
    # shellcheck disable=SC1090
    source "$MODULE_ENV_FILE"
  fi

  # Resolve SSH user precedence (CLI -u overrides everything)
  if [ "$CLI_SSH_USER_SPECIFIED" != true ]; then
    if [ -n "${YAMC_USER:-}" ]; then
      SSH_USER="$YAMC_USER"
    else
      SSH_USER="$(whoami)"
    fi
  fi
  
  #
  # Handle Local-Only Modules
  #
  if [ "$LOCAL_ONLY" = true ]; then
    log INFO "Running local-only: $MODULE/$SUBFUNC"
    
    # Run the local script without SSH/SSHFS setup
    (
      # Export environment variables for the local script
      export MOD_DIR="$MOD_DIR"
      export MOD_TMP="$MOD_TMP"
      export RES_DIR="$RES_DIR"
      export RES_BASE="$RES_BASE"
      export res_profile="$res_profile"
      export ssh_user="$SSH_USER"
      export tgt_host="$HOST"
      
      # Export any -e flag variables
      for var in "${ENV_VARS[@]}"; do
        var_name="${var%%=*}"
        var_value="${var#*=}"
        export "$var_name"="$var_value"
      done
      
      # Source the local script with additional args
      source "$MOD_DIR/${SUBFUNC}.loc" "${MODULE_ARGS[@]}"
    )
    
    LOCAL_EXIT=$?
    
    # Clean up temp directory
    if [ ! -z "$MOD_TMP" ] && [[ "$MOD_TMP" == *"tmp-"* ]] && [ -d "$MOD_TMP" ]; then
      rm -rf "$MOD_TMP" 2>/dev/null || true
    fi
    
    exit $LOCAL_EXIT
  fi

  # Ensure local cache exists (sftp-server path, etc.)
  if ! ensure_local_cache; then
    exit 1
  fi

  # Use cached local SFTP server path
  SFTP_SERVER="$YAMC_SFTP_SERVER"

  # Show summary of what we're doing
  log INFO "YAMC: Configuring '$HOST' with module '$MODULE' (subfunction: $SUBFUNC)"

  # Test SSH connectivity first
  log INFO "Testing SSH connection to $SSH_USER@$HOST..."

  # NOTE: because this script runs with set -e, we must guard this probe inside
  # an if to prevent a silent early exit when SSH fails.
  if ssh -o BatchMode=yes -o ConnectTimeout="$SSH_TIMEOUT" "$SSH_USER@$HOST" "echo 'SSH connection successful'" >/dev/null 2>&1; then
    log INFO "SSH connection successful"
  else
    SSH_RESULT=$?
    log ERROR "SSH connect failed: $SSH_USER@$HOST (exit $SSH_RESULT)"
    log ERROR "Hint: check hostname/DNS, then try: ssh $SSH_USER@$HOST"
    log ERROR "If needed: yamc init -h $HOST -u <sudo_user>"
    exit 1
  fi

  # If this is the first successful connection from this local machine, cache the non-root user
  if [ ! -f "$HOST_CONFIG_FILE" ] && [ -n "$SSH_USER" ] && [ "$SSH_USER" != "root" ]; then
    log INFO "Caching host default user to $HOST_CONFIG_FILE"
    cat > "$HOST_CONFIG_FILE" <<EOF
# YAMC environment configuration for $HOST
# Generated on $(date)
# Host default SSH user (regular / bootstrap user; do not store root here)
YAMC_USER=$SSH_USER
EOF
  fi

  # Process command-line environment variables
  ENV_FILE="$MOD_TMP/env"
  touch "$ENV_FILE"

  # Add any command-line environment variables to the env file
  for var in "${ENV_VARS[@]}"; do
    echo "$var" >> "$ENV_FILE"
  done

  # Run local setup script if it exists
  if [ -f "$MOD_DIR/${SUBFUNC}.loc" ]; then
    log INFO "Running local setup script: ${SUBFUNC}.loc"
    
    # Source the local script in a subshell to avoid environment pollution
    (
      # Export environment variables for the local script
      export MOD_DIR="$MOD_DIR"
      export MOD_TMP="$MOD_TMP"
      export ssh_user="$SSH_USER"
      export tgt_host="$HOST"
      
      # Export resource variables
      export RES_DIR="$RES_DIR"
      export RES_BASE="$RES_BASE"
      export res_profile="$res_profile"
      
      # Export any provided environment variables
      if [ -f "$ENV_FILE" ]; then
        while IFS= read -r line; do
          # Skip empty lines and comments
          [[ -z "$line" || "$line" =~ ^# ]] && continue
          # Extract var name and value
          var_name="${line%%=*}"
          var_value="${line#*=}"
          # Export the variable
          export "$var_name"="$var_value"
        done < "$ENV_FILE"
      fi
      
      # Source the local setup script with additional args
      source "$MOD_DIR/${SUBFUNC}.loc" "${MODULE_ARGS[@]}"
    )
    
    # Check exit status of local script (must capture immediately)
    LOCAL_SCRIPT_STATUS=$?
    if [ $LOCAL_SCRIPT_STATUS -ne 0 ]; then
      log ERROR "Local setup script failed with error code $LOCAL_SCRIPT_STATUS"
      exit $LOCAL_SCRIPT_STATUS
    fi
  fi

  # Create remote temporary directory
  log INFO "Creating remote temporary directory..."
  if ! REMOTE_TMP=$(ssh -o ConnectTimeout="$SSH_TIMEOUT" "$SSH_USER@$HOST" "mktemp -d /tmp/yamc-${MODULE}-XXXXXX"); then
    SSH_RESULT=$?
    log ERROR "Failed to create remote temp dir via SSH (exit $SSH_RESULT)"
    log ERROR "Hint: ssh $SSH_USER@$HOST"
    exit 1
  fi

  if [ -z "$REMOTE_TMP" ]; then
    log ERROR "Failed to create temporary directory on remote host"
    exit 1
  fi

  log INFO "Created remote temporary directory: $REMOTE_TMP"
  log DEBUG "Local module dir: $MOD_DIR"
  log DEBUG "Remote temporary dir: $REMOTE_TMP"

  # Mount the module directory on the remote host (guarded for set -e)
  if ! reverse_sshfs_mount "$MOD_DIR" "$SSH_USER@$HOST" "$REMOTE_TMP" "$SFTP_SERVER"; then
    log ERROR "Failed to set up file sharing (reverse SSHFS)."
    log ERROR "Hint: rerun yamc init for $HOST and verify sshfs is installed on the remote host."
    exit 1
  fi

  # Mount resources directory if it exists
  REMOTE_RES_DIR=""
  REMOTE_RES_BASE=""
  if [ ! -z "$RES_DIR" ] && [ -d "$RES_DIR" ]; then
    log INFO "Setting up resources file sharing..."
    
    # Create remote resources mount point
    if ! REMOTE_RES_DIR=$(ssh -o ConnectTimeout="$SSH_TIMEOUT" "$SSH_USER@$HOST" "mktemp -d /tmp/yamc-res-XXXXXX"); then
      SSH_RESULT=$?
      log ERROR "Failed to create remote resources dir via SSH (exit $SSH_RESULT)"
      log ERROR "Hint: ssh $SSH_USER@$HOST"
      exit 1
    fi
    
    if [ -z "$REMOTE_RES_DIR" ]; then
      log ERROR "Failed to create resources directory on remote host"
      exit 1
    fi
    
    # Mount resources using a separate FIFO
    RES_FIFO="/tmp/yamc-res-fifo-$$"
    log DEBUG "Creating resources named pipe: $RES_FIFO"
    mkfifo -m600 "$RES_FIFO"
    
    # Create the remote directory and mount
    if ! ssh "$SSH_USER@$HOST" "mkdir -p \"$REMOTE_RES_DIR\""; then
      SSH_RESULT=$?
      log ERROR "Failed to create resources mount point on remote host (exit $SSH_RESULT)"
      log ERROR "Hint: ssh $SSH_USER@$HOST"
      exit 1
    fi
    
    log DEBUG "Starting SFTP server for resources"
    < "$RES_FIFO" "$SFTP_SERVER" | ssh "$SSH_USER@$HOST" "sshfs -o slave \":$RES_DIR\" \"$REMOTE_RES_DIR\"" > "$RES_FIFO" &
    
    # Give it a moment to connect
    sleep 2
    
    # Verify the mount was successful
    local res_mount_check
    if ! res_mount_check=$(ssh "$SSH_USER@$HOST" "[ -d \"$REMOTE_RES_DIR/\" ] && ls -la \"$REMOTE_RES_DIR/\" >/dev/null 2>&1 && echo 'mounted' || echo 'failed'"); then
      SSH_RESULT=$?
      log ERROR "Failed to verify resources mount (exit $SSH_RESULT)"
      log ERROR "Hint: ssh $SSH_USER@$HOST"
      rm -f "$RES_FIFO"
      exit 1
    fi
    
    if [ "$res_mount_check" != "mounted" ]; then
      log ERROR "Failed to mount resources directory. SSHFS mount unsuccessful."
      rm -f "$RES_FIFO"
      exit 1
    fi
    
    # Set globals for cleanup
    REMOTE_RES_MOUNT="$REMOTE_RES_DIR"
    RES_FIFO_PATH="$RES_FIFO"
    
    log INFO "Resources sharing established: $RES_DIR -> $SSH_USER@$HOST:$REMOTE_RES_DIR"
    
    # Also mount RES_BASE if different from RES_DIR
    if [ ! -z "$RES_BASE" ] && [ "$RES_BASE" != "$RES_DIR" ] && [ -d "$RES_BASE" ]; then
      # For simplicity, we'll pass RES_BASE path but not mount it separately
      # Scripts can use RES_BASE for local fallback logic in .loc scripts
      REMOTE_RES_BASE="$RES_BASE"
      log DEBUG "RES_BASE differs from RES_DIR - remote scripts should use RES_DIR only"
    else
      REMOTE_RES_BASE="$REMOTE_RES_DIR"
    fi
  fi

  # Prepare environment variables for remote execution
  ENV_EXPORTS=""
  if [ -f "$ENV_FILE" ]; then
    # Read the environment file and build a string of exports
    while IFS= read -r line; do
      # Skip empty lines and comments
      [[ -z "$line" || "$line" =~ ^# ]] && continue
      ENV_EXPORTS+="export $line; "
    done < "$ENV_FILE"
  fi

  # Prepare additional arguments if any
  MODULE_ARGS_STR=""
  if [ ${#MODULE_ARGS[@]} -gt 0 ]; then
    for arg in "${MODULE_ARGS[@]}"; do
      MODULE_ARGS_STR+=" \"$arg\""
    done
  fi

  # Extract the relative path of MOD_TMP from MOD_DIR
  RELATIVE_TMP=${MOD_TMP#$MOD_DIR/}
  
  # Build resource exports for remote execution
  RES_EXPORTS=""
  if [ ! -z "$REMOTE_RES_DIR" ]; then
    RES_EXPORTS="RES_DIR=$REMOTE_RES_DIR RES_BASE=$REMOTE_RES_DIR res_profile=\"$res_profile\" "
  fi
  
  # Run the remote script
  log INFO "Running remote script: $SUBFUNC"
  log DEBUG "Remote command: cd $REMOTE_TMP && $ENV_EXPORTS ${RES_EXPORTS}MOD_DIR=$REMOTE_TMP MOD_TMP=$REMOTE_TMP/$RELATIVE_TMP bash $REMOTE_TMP/$SUBFUNC$MODULE_ARGS_STR"

  if ! ssh -t -o ConnectTimeout="$SSH_TIMEOUT" "$SSH_USER@$HOST" "cd $REMOTE_TMP && $ENV_EXPORTS ${RES_EXPORTS}MOD_DIR=$REMOTE_TMP MOD_TMP=$REMOTE_TMP/$RELATIVE_TMP bash $REMOTE_TMP/$SUBFUNC$MODULE_ARGS_STR"; then
    RESULT=$?
    log ERROR "Remote script execution failed (exit $RESULT)"
    exit $RESULT
  fi

  log INFO "Module '$MODULE' completed successfully on '$HOST'"
  exit 0
}

#
# Main Script Logic
#

# Initialize default values as globals
SSH_USER="${YAMC_USER:-$(whoami)}"  # Use YAMC_USER if set, otherwise current user
HOST="${YAMC_HOST:-}"  # Use YAMC_HOST environment variable if set
PROFILE="${YAMC_PROFILE:-}"  # Use YAMC_PROFILE environment variable if set
RESOURCES_PATH="${YAMC_RESOURCES:-}"  # Use YAMC_RESOURCES environment variable if set
MODULE=""
SUBFUNC="setup"
ENV_VARS=()
VERBOSE=false
SSH_TIMEOUT="$DEFAULT_SSH_TIMEOUT"
INIT_MODE=false
CLI_SSH_USER_SPECIFIED=false

# Look for "init" or "help" as first non-option argument.
# These dispatch paths do not require -h and do not use SSH.
if [ "$1" = "init" ]; then
  INIT_MODE=true
  shift
  parse_init_command "$@"
elif [ "$1" = "help" ]; then
  shift
  parse_help_command "$@"
else
  # Process the options first, then look for init/help
  # Save original args for later
  original_args=("$@")
  
  # Parse just the options, stop at first non-option argument
  while getopts ":h:u:p:r:e:vt:" opt; do
    case $opt in
      h) HOST="$OPTARG" ;;
      u) SSH_USER="$OPTARG" ;;
      p) PROFILE="$OPTARG" ;;
      r) RESOURCES_PATH="$OPTARG" ;;
      e) ENV_VARS+=("$OPTARG") ;;
      v) VERBOSE=true ;;
      t) SSH_TIMEOUT="$OPTARG" ;;
      *) : ;; # Ignore unknown options for now
    esac
  done
  
  # Shift to the first non-option argument
  shift $((OPTIND-1))
  
  # Now check if the first non-option argument is "init" or "help"
  if [ "$1" = "init" ]; then
    INIT_MODE=true
    shift
    # Pass all remaining arguments to the init parser
    parse_init_command "-h" "$HOST" "-u" "$SSH_USER" "$@"
  elif [ "$1" = "help" ]; then
    shift
    parse_help_command "$@"
  elif [ -n "$1" ] && [ "$2" = "help" ]; then
    # Symmetry: 'yamc <module> help' == 'yamc help <module>'
    resolve_install_dir
    resolve_resources_root
    run_module_help "$1"
    exit $?
  else
    # Regular command parsing (non-init mode)
    parse_module_command "${original_args[@]}"
    run_module
  fi
fi