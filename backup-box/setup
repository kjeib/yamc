#!/bin/bash
# backup-box/setup - install and configure rest-server for restic repositories
#
# Serves an append-only restic repository store, bound to the tunnel address
# only. The box never holds a repository password, so everything under
# $BK_REPOS is opaque to this machine.
#
# Usage: yamc -h HOST -e bk_users="uranus" backup-box [-e yes=1]
#
# Options:
#   -e bk_users="a b"     rest-server users to create, one per source host
#   -e bk_addr=10.9.9.2   bind address (default: read from the tunnel iface)
#   -e rsrv_url=URL       override the pinned release (needs rsrv_sha256 too)
#   -e rsrv_sha256=HASH   its sha256; both must be supplied together

set -e

source "$MOD_DIR/common.sh"

bk_banner setup
bk_need_root

# ---------------------------------------------------------------------------
# Preconditions
# ---------------------------------------------------------------------------
bk_mount_ready || bk_die "$BK_MOUNT is not mounted. Run 'backup-box storage' first."

LISTEN_ADDR=$(bk_tunnel_addr)
if [ -z "$LISTEN_ADDR" ]; then
  echo "Could not determine a bind address."
  echo
  echo "  Interface '$BK_IFACE' has no IPv4 address, which means the tunnel is"
  echo "  not up. Run 'wg-peer' first, or pass -e bk_addr=<addr> explicitly."
  echo
  echo "  This is fatal on purpose. Binding a repository service to a wildcard"
  echo "  address on a box in hostile territory would expose it to the local"
  echo "  network it is supposed to be hidden from."
  exit 1
fi

if [ -z "$BK_USERS" ]; then
  bk_die "No users specified. Use -e bk_users=\"<source-host>\" (one per source host)."
fi

# ---------------------------------------------------------------------------
# Report the plan
# ---------------------------------------------------------------------------
echo
echo "PLAN:"
echo "    repository store : $BK_REPOS"
echo "    listen           : $LISTEN_ADDR:$BK_PORT   (tunnel only)"
echo "    mode             : --append-only --private-repos"
echo "    users            : $BK_USERS"
echo
echo "  --append-only means a compromised box cannot delete backup history."
echo "  --private-repos means each user can only reach paths under its own name."
echo
echo "  Existing users keep their credentials; only missing users are created,"
echo "  and their generated password is printed ONCE."

if ! command -v rest-server >/dev/null 2>&1 && [ -f "$MOD_DIR/rest-server.pin" ]; then
  echo
  echo "    rest-server      : v$(grep -E '^RSRV_VERSION=' "$MOD_DIR/rest-server.pin" | cut -d= -f2) (pinned, checksum verified on download)"
fi

bk_gate "install and configure rest-server"

# ---------------------------------------------------------------------------
# Install
#
# Ubuntu does not reliably package rest-server, so prefer a distribution
# package when one exists and otherwise require an explicitly checksummed
# download. An unverified binary that serves your offsite backups is not a
# trade worth making for convenience.
# ---------------------------------------------------------------------------
if command -v rest-server >/dev/null 2>&1; then
  echo
  echo "rest-server already installed: $(command -v rest-server)"
elif apt-get install -y --dry-run rest-server >/dev/null 2>&1; then
  echo
  echo "Installing rest-server from the distribution..."
  bk_run apt-get update -qq
  bk_run apt-get install -y rest-server
else
  echo
  echo "No distribution package for rest-server; using the pinned release."

  # ---- Resolve the release -------------------------------------------------
  # Defaults come from backup-box/rest-server.pin, whose checksums were taken
  # from the project's GPG-signed SHA256SUMS. -e rsrv_url / -e rsrv_sha256
  # override it, but both must be given together: a URL without a checksum
  # would silently install an unverified binary.
  RSRV_URL="${rsrv_url:-}"
  RSRV_SHA="${rsrv_sha256:-}"

  if { [ -n "$RSRV_URL" ] && [ -z "$RSRV_SHA" ]; } || \
     { [ -z "$RSRV_URL" ] && [ -n "$RSRV_SHA" ]; }; then
    bk_die "-e rsrv_url and -e rsrv_sha256 must be given together"
  fi

  if [ -z "$RSRV_URL" ]; then
    PIN="$MOD_DIR/rest-server.pin"
    [ -f "$PIN" ] || bk_die "No pinned release: $PIN is missing"

    RSRV_VERSION=$(grep -E '^RSRV_VERSION=' "$PIN" | cut -d= -f2)
    RSRV_BASE=$(grep -E '^RSRV_BASE=' "$PIN" | cut -d= -f2)
    ARCH=$(dpkg --print-architecture 2>/dev/null || uname -m)
    RSRV_SHA=$(grep -E "^$ARCH\|" "$PIN" | cut -d'|' -f2)

    if [ -z "$RSRV_SHA" ]; then
      echo "  No pinned checksum for architecture '$ARCH'."
      echo "  Architectures in $(basename "$PIN"):"
      grep -E '^[a-z0-9]+\|' "$PIN" | cut -d'|' -f1 | sed 's/^/    /'
      echo
      echo "  Add one (see the header of that file for how to verify it), or"
      echo "  pass -e rsrv_url=... -e rsrv_sha256=... explicitly."
      exit 1
    fi

    RSRV_URL="$RSRV_BASE/v$RSRV_VERSION/rest-server_${RSRV_VERSION}_linux_${ARCH}.tar.gz"
    echo "  version : $RSRV_VERSION  (pinned)"
    echo "  arch    : $ARCH"
  else
    echo "  version : supplied on the command line"
  fi
  echo "  url     : $RSRV_URL"
  echo "  sha256  : $RSRV_SHA"

  # Work in a genuinely local temp dir. $MOD_TMP lives on the sshfs mount back
  # to the yamc host, so downloading and extracting there would push the whole
  # tarball over the network twice.
  WORK=$(mktemp -d /tmp/backup-box.XXXXXX)
  trap 'rm -rf "$WORK"' EXIT

  TARBALL="$WORK/rest-server.tar.gz"
  echo
  echo "Downloading..."
  bk_run curl -fsSL -o "$TARBALL" "$RSRV_URL"

  echo "Verifying checksum..."
  GOT=$(sha256sum "$TARBALL" | awk '{print $1}')
  if [ "$GOT" != "$RSRV_SHA" ]; then
    echo "    expected: $RSRV_SHA"
    echo "    got:      $GOT"
    bk_die "Checksum mismatch. Refusing to install."
  fi
  echo "    ok: $GOT"

  bk_run tar -xzf "$TARBALL" -C "$WORK"

  # The release tarball ships the binary mode 0644, so do NOT filter on the
  # execute bit. Check the ELF magic instead - that is the property actually
  # being asserted, and 'install -m 0755' sets the mode regardless.
  BIN=$(find "$WORK" -type f -name 'rest-server' | head -n1)
  [ -n "$BIN" ] || bk_die "No 'rest-server' file found in the tarball"
  if [ "$(head -c4 "$BIN" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
    bk_die "$BIN is not an ELF executable"
  fi
  bk_run install -m 0755 "$BIN" /usr/local/bin/rest-server
  echo "    installed: $(/usr/local/bin/rest-server --version 2>&1 | head -1)"
fi

# ---------------------------------------------------------------------------
# Service account and repository store
# ---------------------------------------------------------------------------
if ! getent passwd "$BK_SRV_USER" >/dev/null 2>&1; then
  echo
  echo "Creating service account '$BK_SRV_USER'..."
  bk_run useradd --system --no-create-home --shell /usr/sbin/nologin "$BK_SRV_USER"
fi

bk_run mkdir -p "$BK_REPOS" "$BK_CONF_DIR"
bk_run chown -R "$BK_SRV_USER:$BK_SRV_USER" "$BK_REPOS"
bk_run chmod 700 "$BK_REPOS"
# root:restsrv 750 - the service needs execute on the DIRECTORY to reach the
# htpasswd inside it. Owning only the file is not enough.
bk_run chown root:"$BK_SRV_USER" "$BK_CONF_DIR"
bk_run chmod 750 "$BK_CONF_DIR"

# ---------------------------------------------------------------------------
# Credentials
#
# Passwords are generated HERE and printed once, so no secret ever travels
# inbound to this box. Same reasoning as accounts/setpass.
# ---------------------------------------------------------------------------
if ! command -v htpasswd >/dev/null 2>&1; then
  echo
  echo "Installing apache2-utils for htpasswd..."
  bk_run apt-get update -qq
  bk_run apt-get install -y apache2-utils
fi

[ -f "$BK_HTPASSWD" ] || { touch "$BK_HTPASSWD"; chmod 640 "$BK_HTPASSWD"; }

NEW_CREDS=""
for u in $BK_USERS; do
  if grep -q "^$u:" "$BK_HTPASSWD" 2>/dev/null; then
    echo "  user '$u': already present, credential left alone"
    continue
  fi
  PW=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 24)
  htpasswd -b "$BK_HTPASSWD" "$u" "$PW" >/dev/null 2>&1
  NEW_CREDS="$NEW_CREDS$u\t$PW\n"
  echo "  user '$u': created"
done
chown root:"$BK_SRV_USER" "$BK_HTPASSWD"
chmod 640 "$BK_HTPASSWD"

# Print them NOW, not at the end. Anything that fails later - a service that
# will not start, a lost connection - would otherwise leave the credential
# stored in htpasswd but never shown, and the next run would report it as
# already present. Unrecoverable, for no good reason.
if [ -n "$NEW_CREDS" ]; then
  echo
  echo "===================================================================="
  echo "NEW CREDENTIALS - shown once, not recoverable from this box:"
  echo
  printf '%b' "$NEW_CREDS" | while IFS=$'\t' read -r u p; do
    [ -z "$u" ] && continue
    echo "    user:     $u"
    echo "    password: $p"
    echo "    repo URL: rest:http://$u:$p@$LISTEN_ADDR:$BK_PORT/$u/<repo>"
    echo
  done
  echo "  Put these on the SOURCE host, mode 0600. They are NOT the restic"
  echo "  repository password - that is a separate secret which must never"
  echo "  exist on this machine."
  echo "===================================================================="
fi

# ---------------------------------------------------------------------------
# systemd unit
# ---------------------------------------------------------------------------
echo
echo "Writing $BK_UNIT ..."
cat > "$BK_UNIT" <<EOF
[Unit]
Description=restic REST server (backup-box, append-only)
After=network-online.target
Wants=network-online.target

[Service]
User=$BK_SRV_USER
Group=$BK_SRV_USER
ExecStart=/usr/bin/env rest-server \\
  --path $BK_REPOS \\
  --listen $LISTEN_ADDR:$BK_PORT \\
  --htpasswd-file $BK_HTPASSWD \\
  --append-only \\
  --private-repos
Restart=on-failure
RestartSec=10

# This service handles ciphertext only and needs nothing but its data dir.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$BK_REPOS

[Install]
WantedBy=multi-user.target
EOF

bk_run systemctl daemon-reload
bk_run systemctl enable rest-server
bk_run systemctl restart rest-server

sleep 2
if ! systemctl is-active --quiet rest-server; then
  echo
  echo "Service failed to start. Recent log:"
  journalctl -u rest-server -n 30 --no-pager | sed 's/^/    /'
  bk_die "rest-server did not start"
fi

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
echo
echo "===================================================================="
echo "rest-server active on $LISTEN_ADDR:$BK_PORT (append-only, private-repos)"
echo "===================================================================="

echo
echo "===================================================================="
echo "NEXT - and NOT on this machine."
echo "===================================================================="
echo
echo "  This box stores encrypted blobs. It does not read them, and it does"
echo "  not run restic - it only runs rest-server, which is already installed"
echo "  here. restic belongs on the SOURCE, the machine holding the files"
echo "  being backed up, because that is where the encryption happens and"
echo "  where the repository password lives."
echo
for u in $BK_USERS; do
  echo "  On $u  (apt-get install restic, if it is not there yet):"
  echo
  for r in docs mail media; do
    echo "    restic -r rest:http://$u:<password>@$LISTEN_ADDR:$BK_PORT/$u/$r \\"
    echo "           init --repository-version 2"
  done
  echo
done
echo "  \"repository\" here is restic's term for an encrypted backup store."
echo "  Nothing to do with apt or package repositories - 'init' creates an"
echo "  empty backup store under /srv/backup/repos on this box."
echo
echo "  Three stores rather than one: restic's index memory grows with the"
echo "  number of chunks, and maildirs are millions of tiny files. Splitting"
echo "  keeps that cost off the high-value data. See BACKUP.md."
echo
echo "  If 'init' is refused, check the --private-repos path semantics for"
echo "  this rest-server version before working around it. Creating files is"
echo "  what append-only permits, so init should succeed."
