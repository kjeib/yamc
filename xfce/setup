#!/bin/bash
# xfce/setup - Configure XFCE desktop environment on remote Ubuntu system
#
# This module configures the system for graphical boot with XFCE.
# Run AFTER 'packages desktop' to install the actual packages.

set -e

echo "===== Configuring XFCE Desktop Environment ====="

# Verify XFCE is installed
if ! dpkg -s xfce4 &> /dev/null; then
  echo "ERROR: xfce4 package not installed."
  echo "Run 'yamc -h host -u root packages desktop' first."
  exit 1
fi

# Verify lightdm is installed
if ! dpkg -s lightdm &> /dev/null; then
  echo "ERROR: lightdm package not installed."
  echo "Run 'yamc -h host -u root packages desktop' first."
  exit 1
fi

# 1. Install lightdm-gtk-greeter if not present (XFCE-appropriate greeter)
if ! dpkg -s lightdm-gtk-greeter &> /dev/null; then
  echo "Installing lightdm-gtk-greeter..."
  apt-get update -qq
  apt-get install -y lightdm-gtk-greeter
fi

# 2. Configure LightDM to use gtk-greeter and xfce session
echo "Configuring LightDM for XFCE..."
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-xfce.conf << 'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
EOF
echo "  ✓ Created /etc/lightdm/lightdm.conf.d/50-xfce.conf"

# 3. Set graphical target as default (boot to GUI)
echo "Setting graphical.target as default boot target..."
CURRENT_TARGET=$(systemctl get-default)
if [ "$CURRENT_TARGET" != "graphical.target" ]; then
  systemctl set-default graphical.target
  echo "  Changed from '$CURRENT_TARGET' to 'graphical.target'"
else
  echo "  Already set to graphical.target"
fi

# 4. Enable lightdm
echo "Enabling lightdm display manager..."
systemctl enable lightdm

# 5. Install gdmflexiserver helper if provided
if [ -f "$MOD_TMP/gdmflexiserver" ]; then
  echo "Installing gdmflexiserver helper to /usr/local/bin..."
  cp "$MOD_TMP/gdmflexiserver" /usr/local/bin/gdmflexiserver
  chmod 755 /usr/local/bin/gdmflexiserver
fi

# 6. Enforce a single screen locker
#
# xfce4-session Recommends:
#   light-locker | xfce4-screensaver | xscreensaver | gnome-screensaver | mate-screensaver
# apt satisfies that with the FIRST alternative, so light-locker gets pulled in
# even when another locker was explicitly requested in packages/desktop.list.
# The result is two lockers installed and both autostarted from
# /etc/xdg/autostart -- and since both .desktop files carry NoDisplay=true,
# neither appears in Settings > Session and Startup, so the conflict is
# effectively invisible.
#
# They are not equivalent.  light-locker draws no lock screen; it VT-switches
# to a throwaway lightdm greeter, so every unlock costs a greeter session
# teardown (logind UserStopDelaySec, 10s by default) plus a full modeset on
# every display.  xfce4-screensaver locks in place on the running X server.
#
# Override the choice with a one-line yamc.local/xfce/locker file.
LOCKER=xfce4-screensaver
if [ -f "$MOD_TMP/locker" ]; then
  LOCKER=$(tr -d '[:space:]' < "$MOD_TMP/locker")
fi

echo "Enforcing a single screen locker: $LOCKER"

# Install the keeper FIRST, so a bad name in yamc.local aborts here (set -e)
# rather than after the other lockers have already been removed.
if ! dpkg -s "$LOCKER" &> /dev/null; then
  echo "  Installing $LOCKER..."
  apt-get update -qq
  apt-get install -y "$LOCKER"
else
  echo "  $LOCKER already installed"
fi

# Every locker this module knows about; the chosen one is skipped below.
for pkg in light-locker light-locker-settings xfce4-screensaver xscreensaver \
           gnome-screensaver mate-screensaver; do
  # Keep the chosen locker and its companion settings package
  case "$pkg" in "$LOCKER"|"$LOCKER"-settings) continue ;; esac
  if dpkg -s "$pkg" &> /dev/null; then
    echo "  Removing conflicting locker: $pkg"
    apt-get remove -y "$pkg"
  fi
done

# 7. Ensure gnome-keyring unlocks on login (for password managers, etc.)
echo "Checking PAM configuration for gnome-keyring..."
if [ -f /etc/pam.d/lightdm ]; then
  if grep -q "pam_gnome_keyring.so" /etc/pam.d/lightdm; then
    echo "  gnome-keyring already configured in PAM"
  else
    echo "  Adding gnome-keyring to lightdm PAM config..."
    # Add to auth section (after pam_unix.so)
    sed -i '/^auth.*pam_unix.so/a auth optional pam_gnome_keyring.so' /etc/pam.d/lightdm
    # Add to session section
    echo "session optional pam_gnome_keyring.so auto_start" >> /etc/pam.d/lightdm
  fi
fi

# 8. Note about starting lightdm
echo ""
echo "Configuration complete."
echo ""
echo "To start the GUI now, run:"
echo "  systemctl start lightdm"
echo ""
echo "Or reboot the system to boot into graphical mode."

echo "===== XFCE Configuration Complete ====="
exit 0

